{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "nim-thinker": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Nim Thinker",
      "options": {
        "baseURL": "http://localhost:4100/v1",
        "apiKey": "unused",
      },
      "models": {
        "nim-thinker": {
          "name": "Nim Thinker",
        },
      },
    },
    "nim-coder": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Nim Coder",
      "options": {
        "baseURL": "http://localhost:4101/v1",
        "apiKey": "unused",
      },
      "models": {
        "nim-coder": {
          "name": "Nim Coder",
        },
      },
    },
    "vertex-garden": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Vertex AI",
      "options": {
        "baseURL": "http://localhost:4099",
        "apiKey": "unused",
      },
      "models": {
        "zai-org/glm-5-maas": {
          "name": "GLM Mass",
        },
        "deepseek-ai/deepseek-v3.2-maas": {
          "name": "Deepseek Mass",
        },
        "qwen/qwen3-coder-480b-a35b-instruct-maas": {
          "name": "Qwen Mass",
        },
        "moonshotai/kimi-k2-thinking-maas": {
          "name": "Kimi Maas",
        },
      },
    },
    "vertex-ai-global": {
      "npm": "@ai-sdk/google-vertex",
      "name": "Google Vertex",
      "options": {
        "project": "sui-vertex-project",
        "location": "global",
        "googleAuthOptions": {
          "keyFile": "/Users/adlljvd/Workspace/vertex/sui-vertex-project.json",
        },
      },
      "models": {
        "gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro preview",
        },
        "gemini-3-flash-preview": {
          "name": "Gemini 3 Flash preview",
        },
        "gemini-3.1-flash-lite-preview": {
          "name": "Gemini 3.1 Flash lite preview",
        },
      },
    },
  },
}
